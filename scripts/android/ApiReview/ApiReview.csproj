<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings></PropertyGroup>
 <ItemGroup><Reference Include="Mono.Cecil"><HintPath>$(AndroidLoaderPath)/Mono.Cecil.dll</HintPath><Private>true</Private></Reference></ItemGroup>
 <Target Name="RequireCecil" BeforeTargets="PrepareForBuild"><Error Condition="!Exists('$(AndroidLoaderPath)/Mono.Cecil.dll')" Text="Укажите AndroidLoaderPath с Mono.Cecil.dll из закреплённого загрузчика."/></Target>
</Project>
