<UserControl x:Class="DivineLabs.IdleSlayer.Launcher.InstallationFinder"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DivineLabs.IdleSlayer.Launcher">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DivineLabs.DesktopUI;component/SetupTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></UserControl.Resources>
 <Expander Header="{local:Tr OtherCopies}" Foreground="{DynamicResource Text}" FontSize="14" Expanded="Expanded" Margin="0,0,0,18">
  <Border Background="{DynamicResource WhiteSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,10,0,0"><StackPanel>
   <TextBlock x:Name="Description" Text="{local:Tr CopiesBody}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,12"/>
   <WrapPanel><Button x:Name="FindAll" Content="{local:Tr FindCopies}" Click="FindAllClick" Padding="12,7" MinHeight="36" Margin="0,0,8,8"/><Button x:Name="ChooseRoot" Content="{local:Tr ScanFolder}" Click="ChooseRootClick" Padding="12,7" MinHeight="36" Margin="0,0,8,8"/><Button x:Name="CancelSearch" Content="{local:Tr CancelSearch}" Click="CancelClick" Visibility="Collapsed" Padding="12,7" MinHeight="36" Margin="0,0,0,8"/></WrapPanel>
   <TextBlock x:Name="Status" Foreground="{DynamicResource Muted}" FontSize="12" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,6"/>
   <Border x:Name="RemovalConfirmation" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,10"><StackPanel>
    <TextBlock Text="{local:Tr RemoveCopyTitle}" FontWeight="SemiBold"/><TextBlock x:Name="RemovalPath" TextWrapping="Wrap" FontSize="12" Margin="0,6"/>
    <TextBlock Text="{local:Tr RemoveCopyRetention}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Muted}"/>
    <WrapPanel Margin="0,10,0,0"><Button x:Name="ConfirmRemoval" Content="{local:Tr RemoveCopy}" Click="ConfirmRemovalClick" Foreground="{DynamicResource ErrorBrush}" Padding="12,7" Margin="0,0,8,0"/><Button x:Name="CancelRemoval" Content="{local:Tr Cancel}" Click="CancelRemovalClick" Padding="12,7"/></WrapPanel>
   </StackPanel></Border>
   <Button x:Name="RemovalLog" Content="{local:Tr LogShort}" Click="RemovalLogClick" Visibility="Collapsed" HorizontalAlignment="Left" Padding="12,7" Margin="0,0,0,8"/>
   <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Copies"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,8"><DockPanel>
     <Button DockPanel.Dock="Right" Content="{local:Tr RemoveCopy}" Tag="{Binding Folder}" Click="RemoveCopyClick" Foreground="{DynamicResource ErrorBrush}" Padding="12,7" MinHeight="34" Margin="8,0,0,0"/>
     <Button DockPanel.Dock="Right" Visibility="{Binding FolderSelectionVisibility,RelativeSource={RelativeSource AncestorType={x:Type local:InstallationFinder}}}" Content="{local:Tr ChooseCopy}" Tag="{Binding Folder}" Click="ChooseCopyClick" Padding="12,7" MinHeight="34" Margin="12,0,0,0"/>
     <StackPanel><TextBlock Text="{Binding Folder}" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
    </DockPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </StackPanel></Border>
 </Expander>
</UserControl>
