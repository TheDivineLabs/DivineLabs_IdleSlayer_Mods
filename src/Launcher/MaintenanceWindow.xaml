<Window x:Class="DivineLabs.IdleSlayer.Launcher.MaintenanceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DivineLabs Idle Slayer Mods" Width="1060" Height="750" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DivineLabs.DesktopUI;component/SetupTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="292" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="#181927" ClipToBounds="True">
      <Grid>
        <Image Source="Installer.cover.png" Stretch="UniformToFill" />
        <Rectangle>
          <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#18121A30" Offset="0" />
              <GradientStop Color="#0F121A30" Offset=".40" />
              <GradientStop Color="#E0151725" Offset="1" />
            </LinearGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,36">
          <Image Height="48" Stretch="Uniform" Margin="0,0,0,28">
            <Image.Source>
              <CroppedBitmap SourceRect="0,122,640,130">
                <CroppedBitmap.Source>
                  <BitmapImage UriSource="IdleSlayer.wordmark.png" />
                </CroppedBitmap.Source>
              </CroppedBitmap>
            </Image.Source>
          </Image>
          <Border BorderBrush="#45FFFFFF" BorderThickness="0,1,0,0" Padding="0,22,0,0">
            <StackPanel Orientation="Horizontal">
              <Border Width="32" Height="32" CornerRadius="9" Background="#6658E8" Margin="0,0,10,0">
                <Viewbox Margin="3">
                  <Path Width="128" Height="128" Fill="White" Data="M28,38 C28,22 40,16 54,16 L64,16 C82,16 96,26 104,42 L50,42 C41,42 33,47 28,54 Z M28,66 C28,54 40,48 52,48 L106,48 C109,58 109,67 106,78 L50,78 C41,78 33,83 28,91 Z M28,102 C28,90 40,84 52,84 L103,84 C95,102 79,114 61,114 L49,114 C40,114 33,119 28,124 Z" />
                </Viewbox>
              </Border>
              <StackPanel>
                <TextBlock Text="DivineLabs" Foreground="White" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="Ваши настройки. Ваш темп игры." Foreground="#C5CCD9" FontSize="11" Margin="0,2,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="40,28,40,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="ModeLabel" Text="УСТАНОВКА" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock Text="DivineLabs Idle Slayer Mods" FontSize="23" FontWeight="SemiBold" />
        <Grid Margin="0,26,0,24">
          <Border Height="1" Background="{DynamicResource Line}" VerticalAlignment="Top" Margin="67,14,67,0" />
          <ItemsControl x:Name="Steps" IsTabStop="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="28" Height="28" CornerRadius="14" Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1">
                    <TextBlock Text="{Binding Number}" Foreground="{Binding Foreground}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                  </Border>
                  <TextBlock Text="{Binding Title}" Foreground="{Binding Label}" FontSize="11" Margin="0,7,0,0" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </StackPanel>
      <Grid x:Name="Pages" Grid.Row="1">
        <StackPanel x:Name="WelcomePage" VerticalAlignment="Center" Margin="0,-8,0,12">
          <Image Source="DivineLabs.png" Width="88" Height="88" HorizontalAlignment="Left" Margin="0,0,0,25" RenderOptions.BitmapScalingMode="NearestNeighbor" />
          <TextBlock x:Name="WelcomeTitle" Text="Добро пожаловать" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock x:Name="WelcomeText" Text="Настройте игру под себя. Установим лаунчер, меню и игровые компоненты за несколько шагов." Foreground="{DynamicResource Muted}" FontSize="16" LineHeight="25" Margin="0,0,0,28" />
          <Border Background="#F0EEFF" CornerRadius="10" Padding="18">
            <StackPanel>
              <TextBlock x:Name="WelcomeDetail" Text="Монеты и урон · Настраиваемое меню" FontWeight="SemiBold" Foreground="#5548BF" />
              <TextBlock x:Name="WelcomeNote" Text="Готовый комплект для Windows x64 и Steam." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,7,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
        <Grid x:Name="LicensePage" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Лицензии и компоненты" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Text="Собственный код — Apache 2.0. Лицензии загрузчика и зависимостей сохранены в комплекте." Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,14" />
          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ComboBox x:Name="LicenseSelector" DisplayMemberPath="Title" SelectionChanged="LicenseChanged" Margin="0,0,0,8" Padding="10" MaxDropDownHeight="240" />
            <TextBox x:Name="LicenseText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11" Padding="14" Margin="0" FontFamily="Consolas" />
          </Grid>
          <CheckBox x:Name="Accepted" Grid.Row="3" Margin="0,16,0,4" Checked="AcceptanceChanged" Unchecked="AcceptanceChanged">
            <TextBlock Text="Принимаю условия Apache 2.0 и ознакомился с лицензиями компонентов." FontSize="12" MaxWidth="540" />
          </CheckBox>
        </Grid>
        <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
          <TextBlock x:Name="OptionsTitle" Text="Всё на своём месте" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,10" />
          <TextBlock x:Name="OptionsDescription" Text="Выберите папку программы и нужные ярлыки." Foreground="{DynamicResource Muted}" Margin="0,0,0,26" />
          <TextBlock Text="Папка программы" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
          <DockPanel>
            <Button x:Name="Browse" Content="Выбрать…" DockPanel.Dock="Right" Click="BrowseClick" Margin="10,0,0,0" />
            <TextBox x:Name="TargetPath" TextChanged="PathChanged" Margin="0" VerticalContentAlignment="Center" />
          </DockPanel>
          <TextBlock x:Name="PathHint" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,24" />
          <CheckBox x:Name="Shortcuts" Content="Ярлыки на рабочем столе и в меню «Пуск»" IsChecked="True" Margin="0,0,0,28" />
          <Border Background="#F0F2F8" CornerRadius="10" Padding="18">
            <StackPanel>
              <TextBlock x:Name="RetentionTitle" Text="Настройки останутся с вами" FontWeight="SemiBold" />
              <TextBlock x:Name="Retention" Text="При обновлении сохраняются настройки и резервные копии. Саму игру устанавливать заново не нужно." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="ProgressPage" Visibility="Collapsed" VerticalAlignment="Center">
          <TextBlock x:Name="ProgressTitle" Text="Готовим всё для игры" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="ProgressDescription" Text="Распаковываем комплект и устанавливаем компоненты в выбранную папку." Foreground="{DynamicResource Muted}" Margin="0,0,0,32" />
          <ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" />
          <DockPanel Margin="0,14,0,0">
            <TextBlock x:Name="Percent" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
            <TextBlock x:Name="Status" Text="Подготовка…" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,12,0" />
          </DockPanel>
          <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#FFF0F1" CornerRadius="10" Padding="16" Margin="0,24,0,0">
            <StackPanel>
              <TextBlock Text="Нужна ваша помощь" FontWeight="SemiBold" Foreground="#A32C42" />
              <TextBlock x:Name="ErrorText" Foreground="#8B3D4B" FontSize="12" Margin="0,8,0,12" />
              <Button x:Name="Log" Content="Открыть журнал" Click="LogClick" HorizontalAlignment="Left" Margin="0" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel x:Name="ResultPage" Visibility="Collapsed" VerticalAlignment="Center">
          <Border Width="64" Height="64" Background="#E7F6EF" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,24">
            <TextBlock Text="✓" Foreground="#24855C" FontSize="34" HorizontalAlignment="Center" />
          </Border>
          <TextBlock x:Name="ResultTitle" Text="Всё готово к запуску" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="ResultDescription" Text="DivineLabs Idle Slayer Mods установлен. Откройте лаунчер и начните игру." Foreground="{DynamicResource Muted}" FontSize="16" LineHeight="25" Margin="0,0,0,24" />
          <TextBlock x:Name="ResultPath" Foreground="{DynamicResource Muted}" FontSize="12" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="0,26,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="InlineNotice" Foreground="#A32C42" FontSize="12" Margin="0,0,0,10" />
        <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
          <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button x:Name="Back" Content="Назад" Click="BackClick" Margin="0,0,8,0" Visibility="Collapsed" />
              <Button x:Name="Cancel" Content="Отмена" Click="CancelClick" Margin="0,0,8,0" />
              <Button x:Name="Primary" Content="Далее →" Style="{StaticResource Primary}" Click="PrimaryClick" Margin="0" />
            </StackPanel>
            <TextBlock Text="DivineLabs · Windows x64" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>