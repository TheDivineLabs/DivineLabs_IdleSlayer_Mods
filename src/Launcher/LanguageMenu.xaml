<UserControl x:Class="DivineLabs.IdleSlayer.Launcher.LanguageMenu"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:DivineLabs.IdleSlayer.Launcher" Focusable="False">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/DivineLabs.DesktopUI;component/SetupTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="LanguageTile" TargetType="Button" BasedOn="{StaticResource LanguageOption}"><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
 </ResourceDictionary></UserControl.Resources>
 <Grid>
  <Button x:Name="Trigger" Click="ToggleMenu" PreviewKeyDown="TriggerKeyDown" Width="140" MinWidth="140" Height="34" MinHeight="34" Margin="0" Padding="10,5" FocusVisualStyle="{StaticResource KeyboardFocus}" AutomationProperties.Name="{local:Tr Language}">
   <Button.Template><ControlTemplate TargetType="Button">
    <Border x:Name="Body" Background="{DynamicResource HeaderSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="{DynamicResource HoverSurface}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Button.Template>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/></Grid.ColumnDefinitions>
    <Image x:Name="CurrentFlag" Width="16" Height="12" VerticalAlignment="Center"/><TextBlock x:Name="CurrentLabel" Grid.Column="1" FontSize="12" Margin="7,0,5,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
    <Path Grid.Column="2" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="5" VerticalAlignment="Center"/>
   </Grid>
  </Button>
  <Popup x:Name="Menu" PlacementTarget="{Binding ElementName=Trigger}" Placement="Bottom" HorizontalOffset="-370" StaysOpen="True" AllowsTransparency="True" PopupAnimation="None" Opened="MenuOpened">
   <Border x:Name="MenuPanel" PreviewKeyDown="MenuKeyDown" Background="{DynamicResource WhiteSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="8" Width="510" Margin="0,6,0,0" KeyboardNavigation.TabNavigation="Cycle" TextElement.Foreground="{DynamicResource Text}">
    <StackPanel>
     <TextBlock Text="{local:Tr Language}" Foreground="{DynamicResource Muted}" FontSize="10" Margin="10,2,10,6"/>
     <Button x:Name="Auto" Tag="auto" Click="SelectLanguage" Style="{StaticResource LanguageTile}">
      <DockPanel><Image Source="{StaticResource FlagAuto}" Width="18" Height="18" Margin="0,0,10,0"/><StackPanel><TextBlock Text="{local:Tr Automatic}" FontSize="12"/><TextBlock x:Name="Recommended" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,2,0,0"/></StackPanel></DockPanel>
     </Button>
     <UniformGrid x:Name="LanguageGrid" Columns="3">
       <Button x:Name="Russian" Tag="ru" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagRu}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Россия" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RuCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="English" Tag="en" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagEn}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="United Kingdom" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EnCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="Ukrainian" Tag="uk" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagUk}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Україна" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="UkCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="Belarusian" Tag="be" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagBy}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Беларусь" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ByCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="German" Tag="de" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagDe}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="Deutschland" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="DeCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="Spanish" Tag="es" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagEs}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="España" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="EsCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="Korean" Tag="ko" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagKr}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="대한민국" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="KrCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="Chinese" Tag="zh" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagCn}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="中国" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="CnCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
       <Button x:Name="Japanese" Tag="ja" Click="SelectLanguage" Style="{StaticResource LanguageTile}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions><Image Source="{StaticResource FlagJp}" Width="18" Height="12" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="日本" FontSize="12" Margin="7,0,3,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="JpCheck" Grid.Column="2" Text="✓" Foreground="{DynamicResource Accent}" FontSize="12"/></Grid></Button>
     </UniformGrid>
    </StackPanel>
   </Border>
  </Popup>
 </Grid>
</UserControl>
