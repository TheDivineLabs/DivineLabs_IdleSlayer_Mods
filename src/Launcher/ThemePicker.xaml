<UserControl x:Class="DivineLabs.IdleSlayer.Launcher.ThemePicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ComboBox x:Name="Choice" Width="140" Height="34" MinHeight="34" FontSize="12" Margin="0" Padding="8,5" SelectionChanged="ThemeChanged" AutomationProperties.Name="Theme">
  <ComboBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="{Binding Icon}" Stroke="{DynamicResource Text}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" Margin="7,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></Grid></DataTemplate></ComboBox.ItemTemplate>
 </ComboBox>
</UserControl>
