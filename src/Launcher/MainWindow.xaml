<Window x:Class="DivineLabs.IdleSlayer.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DivineLabs.IdleSlayer.Launcher" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="DivineLabs Idle Slayer Mods" Width="1120" Height="800" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" WindowStyle="None" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DivineLabs.DesktopUI;component/ApplicationTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="{DynamicResource Background}" BorderBrush="{DynamicResource Line}" BorderThickness="1" TextElement.FontFamily="Segoe UI" TextElement.Foreground="{DynamicResource Text}">
  <Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition/></Grid.RowDefinitions>
    <Border Background="{DynamicResource HeaderSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="16,0,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource ChromeButton}" Click="MinimizeClick" AutomationProperties.Name="Свернуть"><Image Source="{StaticResource MinimizeIcon}" Width="12" Height="1.2"/></Button>
          <Button Style="{StaticResource ChromeButton}" Click="MaximizeClick" AutomationProperties.Name="Развернуть"><Image Style="{StaticResource MaximizeGlyph}"/></Button>
          <Button Style="{StaticResource ChromeButton}" Click="CloseClick" AutomationProperties.Name="Закрыть"><Image Source="{StaticResource CloseIcon}" Width="12" Height="12"/></Button>
        </StackPanel>
        <local:ThemePicker DockPanel.Dock="Right" Margin="0,0,16,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><local:LanguageMenu x:Name="LanguagePicker" DockPanel.Dock="Right" Margin="0,0,12,0" VerticalAlignment="Center" LanguageChanged="LanguageChanged" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource BadgeLogo}" Width="28" Height="28" Margin="0,0,12,0"/><TextBlock Text="DivineLabs Idle Slayer Mods" FontWeight="SemiBold" FontSize="16"/></StackPanel>
      </DockPanel>
    </Border>
  <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource HeaderSurface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,28">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,0,0,8">
            <Image Source="{StaticResource BadgeLogo}" Width="28" Height="28" Margin="0,0,8,0" />
            <TextBlock Text="DivineLabs" Foreground="{DynamicResource Accent}" FontSize="15" FontWeight="Bold" />
          </StackPanel>
          <TextBlock Text="IDLE SLAYER" Style="{StaticResource Caption}" Margin="8,0,0,32" />
          <Button x:Name="NavHome" Content="{local:Tr Home}" Tag="home" Click="Navigate" Style="{StaticResource NavigationButton}" />
          <Button x:Name="NavFeatures" Content="{local:Tr Functions}" Tag="features" Click="Navigate" Style="{StaticResource NavigationButton}" />
          <Button x:Name="NavResources" Content="{local:Tr Resources}" Tag="resources" Click="Navigate" Style="{StaticResource NavigationButton}" />
          <Button x:Name="NavSettings" Content="{local:Tr Settings}" Tag="settings" Click="Navigate" Style="{StaticResource NavigationButton}" />
          <Button x:Name="NavClients" Tag="clients" Click="Navigate" Style="{StaticResource NavigationButton}"><TextBlock Text="{local:Tr Clients}" TextWrapping="Wrap"/></Button>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <TextBlock x:Name="Connection" Text="{local:Tr NoConnection}" Foreground="{DynamicResource Muted}" Margin="8,12" />
          <TextBlock Text="DivineLabs / 0.5.1" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8" />
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <local:ClientsView x:Name="ClientsPage" Visibility="Collapsed"/>
      <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Image Source="Installer.cover.png" Height="176" Stretch="UniformToFill"/>
              <StackPanel Grid.Column="1" Margin="26,22" VerticalAlignment="Center"><TextBlock Text="DivineLabs · Idle Slayer" Foreground="{DynamicResource Accent}" FontSize="11"/><TextBlock Text="{local:Tr Pace}" FontSize="29" FontWeight="SemiBold" Margin="0,8,0,12"/><TextBlock Text="{local:Tr HomeBody}" Style="{StaticResource Caption}" Margin="0"/></StackPanel>
            </Grid>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock x:Name="State" FontSize="23" FontWeight="SemiBold" />
              <TextBlock x:Name="Detail" Style="{StaticResource Caption}" />
              <ProgressBar x:Name="Progress" Visibility="Collapsed" Margin="0,6,0,18" />
              <WrapPanel>
                <Button x:Name="Play" Content="{local:Tr Play}" Style="{StaticResource Primary}" Click="PlayClick" />
                <Button x:Name="Vanilla" Content="{local:Tr Vanilla}" Click="VanillaClick" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <local:SocialLinks Margin="0,0,0,16"/>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{local:Tr YourFeatures}" FontSize="19" Margin="0,0,0,16" />
              <TextBlock x:Name="Summary" FontSize="19" TextWrapping="Wrap" />
              <TextBlock x:Name="MenuHint" Style="{StaticResource Caption}" />
              <Button Content="{local:Tr ConfigureFeatures}" Tag="features" Click="Navigate" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="FeaturesPage" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="{local:Tr Functions}" Style="{StaticResource Heading}" />
          <CheckBox x:Name="AllEnabled" Content="{local:Tr FeaturesEnabled}" Click="AllClick" />
          <TextBlock Text="{local:Tr SearchFeatures}" Style="{StaticResource Caption}" />
          <TextBox x:Name="Search" ToolTip="{local:Tr SearchCategory}" TextChanged="FilterChanged" />
          <WrapPanel>
            <Button Content="{local:Tr All}" Tag="all" Click="CategoryClick" />
            <Button Content="{local:Tr Favorites}" Tag="favorites" Click="CategoryClick" />
            <Button Content="{local:Tr Economy}" Tag="Экономика" Click="CategoryClick" />
            <Button Content="{local:Tr Combat}" Tag="Бой" Click="CategoryClick" />
            <Button Content="{local:Tr Purchases}" Tag="Покупки" Click="CategoryClick" />
          </WrapPanel>
        </StackPanel>
        <ListBox x:Name="FeatureList" Grid.Row="1">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <DockPanel>
                    <Button Content="{Binding FavoriteLabel}" Tag="{Binding Id}" Click="FavoriteClick" DockPanel.Dock="Right" ToolTip="{local:Tr Favorites}" />
                    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
                  </DockPanel>
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                  <CheckBox Content="{local:Tr Enabled}" IsChecked="{Binding Enabled,Mode=OneWay}" Tag="{Binding Id}" Click="FeatureEnabledClick" />
                  <WrapPanel Visibility="{Binding MultiplierVisibility}">
                    <TextBox Text="{Binding Value,Mode=OneWay}" Width="150" FontSize="22" Tag="{Binding Id}" LostKeyboardFocus="NumberCommit" KeyDown="NumberKey" />
                    <Button Content="×1" Tag="{Binding Id}" Click="PresetClick" />
                    <Button Content="×10" Tag="{Binding Id}" Click="PresetClick" />
                    <Button Content="×100" Tag="{Binding Id}" Click="PresetClick" />
                    <Button Content="×1000" Tag="{Binding Id}" Click="PresetClick" />
                  </WrapPanel>
                  <TextBlock Text="{Binding Error}" Foreground="#A32C42" Margin="0,0,0,8" />
                  <Button Content="{Binding KeyLabel}" Tag="{Binding Id}" Click="CaptureClick" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
      <local:ResourceView x:Name="ResourcesPage" Visibility="Collapsed" />
      <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="{local:Tr Settings}" Style="{StaticResource Heading}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{local:Tr Keys}" FontSize="20" />
              <TextBlock Text="{local:Tr KeyHelp}" Style="{StaticResource Caption}" />
              <ItemsControl x:Name="KeyList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <DockPanel>
                      <TextBlock Text="{Binding Title}" Width="190" />
                      <Button Content="{Binding Label}" Tag="{Binding Id}" Click="CaptureClick" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{local:Tr GameUi}" FontSize="20" Margin="0,0,0,12" />
              <CheckBox x:Name="WidgetVisible" Content="{local:Tr ShowWidget}" Click="WidgetClick" />
              <CheckBox x:Name="ActiveListVisible" Content="{local:Tr ActiveList}" Click="ActiveListClick" />
              <CheckBox x:Name="ReduceMotion" Content="{local:Tr ReduceMotion}" Click="MotionClick" />
              <TextBlock Text="{local:Tr WidgetOpacity}" Style="{StaticResource Caption}" />
              <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" PreviewMouseLeftButtonUp="VisualCommit" PreviewKeyUp="VisualKeyCommit" />
              <TextBlock Text="{local:Tr MenuScale}" Style="{StaticResource Caption}" />
              <Slider x:Name="ScaleSlider" Minimum="75" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" PreviewMouseLeftButtonUp="VisualCommit" PreviewKeyUp="VisualKeyCommit" />
              <Button Content="{local:Tr ResetWidget}" Click="ResetWidget" Margin="0,18,0,0" HorizontalAlignment="Left" />
              <TextBlock Text="{local:Tr DragWidget}" Style="{StaticResource Caption}" />
            </StackPanel>
          </Border>
          <Expander Header="Обслуживание" Foreground="{DynamicResource Text}" Margin="0,0,0,20">
            <StackPanel Margin="0,16,0,0">
              <TextBlock x:Name="GamePath" Style="{StaticResource Caption}" />
              <WrapPanel>
                <Button x:Name="Choose" Content="{local:Tr ChooseGame}" Click="ChooseGame" />
                <Button x:Name="Repair" Content="{local:Tr Repair}" Click="RepairClick" />
                <Button x:Name="Restore" Content="{local:Tr Restore}" Click="RestoreClick" />
                <Button Content="{local:Tr AppHome}" Click="OpenHome" />
                <Button Content="{local:Tr LogShort}" Click="OpenLog" />
              </WrapPanel>
            </StackPanel>
          </Expander>
          <Expander Header="Компоненты и лицензии" Foreground="{DynamicResource Text}">
            <TextBlock Margin="0,16" Style="{StaticResource Caption}" Text="DivineLabs · MIT. DivineLabs_Loader · MelonLoader 0.7.3 (Apache-2.0). .NET · Unity · Harmony · Il2CppInterop. Docs/Licenses." />
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
        <TextBlock x:Name="Notice" Foreground="{DynamicResource Muted}" Text="{local:Tr AutoChanges}" />
      </Border>
    </Grid>
  </Grid>
  </Grid>
  </Border>
</Window>
