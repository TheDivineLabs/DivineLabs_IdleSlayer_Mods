<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:DivineLabs.DesktopUI">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
  <SolidColorBrush x:Key="ErrorBrush" Color="#A32C42"/><SolidColorBrush x:Key="Background" Color="#FAFBFE"/>
  <SolidColorBrush x:Key="Surface" Color="#F0F2F8"/>
  <SolidColorBrush x:Key="Line" Color="#DEE3ED"/>
  <SolidColorBrush x:Key="Accent" Color="#6658E8"/>
  <SolidColorBrush x:Key="Text" Color="#1B2638"/>
  <SolidColorBrush x:Key="Muted" Color="#667389"/>
  <SolidColorBrush x:Key="SelectedSurface" Color="#F2EFFF"/>
  <SolidColorBrush x:Key="WhiteSurface" Color="White"/>
  <Style x:Key="SetupButton" TargetType="Button">
    <Setter Property="Background" Value="#EFF1F7"/><Setter Property="Foreground" Value="#263147"/><Setter Property="BorderBrush" Value="#DEE3ED"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0"/>
    <Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <Grid><Border x:Name="Hover" Background="#166658E8" Opacity="0" CornerRadius="7" Margin="-8,-5"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1"/><Setter TargetName="Body" Property="BorderBrush" Value="#A69CF5"/></Trigger>
        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="ui:Motion.Enabled" Value="True"/></MultiTrigger.Conditions><MultiTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" FillBehavior="Stop"/></Storyboard></BeginStoryboard></MultiTrigger.EnterActions></MultiTrigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".78"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#6658E8"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SocialButton" TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="44"/></Style>
  <Style x:Key="LanguageOption" TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="52"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#F2EFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="Background" Value="#EAE5FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="0"/></Style>
  <DrawingImage x:Key="FlagRu"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="White" Geometry="M0,0 H30 V6 H0 Z"/><GeometryDrawing Brush="#3265B0" Geometry="M0,6 H30 V12 H0 Z"/><GeometryDrawing Brush="#D84B54" Geometry="M0,12 H30 V18 H0 Z"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="FlagEn"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="#23457B" Geometry="M0,0 H30 V18 H0 Z"/><GeometryDrawing Pen="{x:Null}" Brush="White" Geometry="M0,0 H4 L30,15 V18 H26 L0,3 Z M30,0 H26 L0,15 V18 H4 L30,3 Z"/><GeometryDrawing Brush="#C94958" Geometry="M0,0 H2 L30,17 V18 H28 L0,1 Z M30,0 H28 L0,17 V18 H2 L30,1 Z"/><GeometryDrawing Brush="White" Geometry="M11,0 H19 V18 H11 Z M0,5 H30 V13 H0 Z"/><GeometryDrawing Brush="#C94958" Geometry="M13,0 H17 V18 H13 Z M0,7 H30 V11 H0 Z"/></DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <DrawingImage x:Key="FlagAuto"><DrawingImage.Drawing><GeometryDrawing><GeometryDrawing.Pen><Pen Brush="#6658E8" Thickness="1.5"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><GeometryGroup><EllipseGeometry Center="10,10" RadiusX="9" RadiusY="9"/><EllipseGeometry Center="10,10" RadiusX="4" RadiusY="9"/><LineGeometry StartPoint="1,10" EndPoint="19,10"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingImage.Drawing></DrawingImage>
  <Style TargetType="Button" BasedOn="{StaticResource SetupButton}">
    <Setter Property="Background" Value="#EFF1F7"/><Setter Property="Foreground" Value="#263147"/><Setter Property="BorderBrush" Value="#DDE2ED"/><Setter Property="MinHeight" Value="42"/>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="MinHeight" Value="42"/>
    <Setter Property="Background" Value="#6658E8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#6658E8"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinWidth" Value="130"/>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}">
    <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#1B2638"/><Setter Property="CaretBrush" Value="#6658E8"/><Setter Property="BorderBrush" Value="#DDE2ED"/>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource BaseCheckBox}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border x:Name="Box" Width="20" Height="20" VerticalAlignment="Center" Background="White" BorderBrush="#BAC3D3" BorderThickness="1" CornerRadius="5">
          <TextBlock x:Name="Tick" Text="✓" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Border>
        <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#6658E8"/><Setter TargetName="Box" Property="BorderBrush" Value="#6658E8"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#6658E8"/><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#263147"/><Setter Property="Padding" Value="12,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Body" Background="White" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Body" Property="Background" Value="#F0EEFF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Body" Property="Background" Value="#E6E1FF"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#263147"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEE3ED"/><Setter Property="Padding" Value="12,10"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/>
        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="13,10,36,10" VerticalAlignment="Center"/>
        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Background="Transparent">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path Data="M0,0 L5,5 10,0" Stroke="#667389" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <Border Background="White" BorderBrush="#DEE3ED" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0">
            <ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#6658E8"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DrawingImage x:Key="BadgeLogo"><DrawingImage.Drawing><DrawingGroup>
    <GeometryDrawing Brush="#6658E8"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8"/></GeometryDrawing.Geometry></GeometryDrawing>
    <DrawingGroup><DrawingGroup.Transform><MatrixTransform Matrix=".22,0,0,.22,1.04,.6"/></DrawingGroup.Transform><GeometryDrawing Brush="White" Geometry="M28,38 C28,22 40,16 54,16 L64,16 C82,16 96,26 104,42 L50,42 C41,42 33,47 28,54 Z M28,66 C28,54 40,48 52,48 L106,48 C109,58 109,67 106,78 L50,78 C41,78 33,83 28,91 Z M28,102 C28,90 40,84 52,84 L103,84 C95,102 79,114 61,114 L49,114 C40,114 33,119 28,124 Z"/></DrawingGroup>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <Style TargetType="ProgressBar">
    <Setter Property="Foreground" Value="#6658E8"/><Setter Property="Background" Value="#E2E7F0"/><Setter Property="Height" Value="6"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
      <Grid x:Name="PART_Track" ClipToBounds="True"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
