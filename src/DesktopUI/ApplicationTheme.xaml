<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SetupTheme.xaml"/></ResourceDictionary.MergedDictionaries>
 <SolidColorBrush x:Key="Surface" Color="White"/>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEE3ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
 <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12"><ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#F0EDFC"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#6658E8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Body" Property="Opacity" Value=".7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="Margin" Value="0,0,8,8"/></Style>
 <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource SetupButton}"><Setter Property="Background" Value="#6658E8"/><Setter Property="BorderBrush" Value="#6658E8"/><Setter Property="Foreground" Value="White"/><Setter Property="MinWidth" Value="140"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,8,8"/></Style>
</ResourceDictionary>
